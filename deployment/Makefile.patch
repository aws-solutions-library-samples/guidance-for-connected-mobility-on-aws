# Add this to your existing Makefile's interactive deployment section

# In the deploy-interactive target, update the deployment options:

echo "$(GREEN)Deployment Options:$(NC)"; \
echo "1. Deploy MSK only"; \
echo "2. Deploy Flink only"; \
echo "3. Deploy UI only"; \
echo "4. Deploy MSK + Flink (Sequential)"; \
echo "5. Deploy MSK + Flink (Parallel - FAST)"; \
echo "6. Deploy MSK + Flink + UI (Sequential)"; \
echo "7. Deploy MSK + Flink + UI (Parallel - FAST)"; \
echo "8. Full sequential deployment"; \
echo "9. Integration only"; \
echo ""; \

# And update the case statement:
case $$deploy_choice in \
	1) echo "$(BLUE)🚀 Deploying MSK stack...$(NC)"; \
	   $(MAKE) deploy-msk AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage ;; \
	2) echo "$(BLUE)🚀 Deploying Flink stack...$(NC)"; \
	   $(MAKE) deploy-flink AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage ;; \
	3) echo "$(BLUE)🚀 Deploying UI stack...$(NC)"; \
	   $(MAKE) deploy-ui AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage ;; \
	4) echo "$(BLUE)🚀 Deploying MSK + Flink (Sequential)...$(NC)"; \
	   $(MAKE) deploy-msk AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage && \
	   $(MAKE) deploy-flink AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage ;; \
	5) echo "$(BLUE)⚡ Deploying MSK + Flink (Parallel - FAST)...$(NC)"; \
	   $(MAKE) deploy-msk-flink-parallel AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage ;; \
	6) echo "$(BLUE)🚀 Deploying MSK + Flink + UI (Sequential)...$(NC)"; \
	   $(MAKE) deploy-msk AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage && \
	   $(MAKE) deploy-flink AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage && \
	   $(MAKE) deploy-ui AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage ;; \
	7) echo "$(BLUE)⚡ Deploying MSK + Flink + UI (Parallel - FAST)...$(NC)"; \
	   $(MAKE) deploy-msk-flink-parallel AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage && \
	   $(MAKE) deploy-ui AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage ;; \
	8) echo "$(BLUE)🚀 Full sequential deployment...$(NC)"; \
	   $(MAKE) deploy-sequential AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage ;; \
	9) echo "$(BLUE)🚀 Running integrations...$(NC)"; \
	   cd scripts && AWS_PROFILE=$$selected_profile DEPLOYMENT_STAGE=$$selected_stage python3 fast_msk_integration.py ;; \
	*) echo "$(RED)❌ Invalid deployment option$(NC)"; exit 1 ;; \
esac;
