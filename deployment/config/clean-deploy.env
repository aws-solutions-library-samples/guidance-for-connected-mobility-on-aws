# CMS clean-deploy integration test environment.
#
# Sourced by `make clean-deploy-test` and
# `deployment/scripts/run_clean_deploy_test.sh` (Group 3.1, 3.2).
# Override any value via env var before sourcing — defaults below
# apply when the var is unset.
#
# Spec: .kiro/specs/2026-06-01-clean-deploy-integration-tests/spec.md
# PRD:  ~/.kiro/portfolio/initiatives/2026-06-01-clean-deploy-integration-tests/prd.md
#
# This file is sourced by bash; keep syntax POSIX-compatible
# (no arrays, no [[ ... ]]). Never put credentials, account IDs, or
# secrets here.

# --- Region + stage --------------------------------------------------
# Default region per spec amendment #4: ap-northeast-1 first-run target.
# Override with `AWS_REGION=<code> make clean-deploy-test` or by
# exporting AWS_REGION before sourcing.
export AWS_REGION="${AWS_REGION:-ap-northeast-1}"

# Deployment stage. v1 harness only validates `staging`; any other
# value is a future extension.
export DEPLOYMENT_STAGE="${DEPLOYMENT_STAGE:-staging}"

# --- Account pinning (optional but strongly recommended) -------------
# When set, the orchestrator's `preflight_env` phase asserts that the
# resolved AWS account ID (via `aws sts get-caller-identity`) matches
# this value EXACTLY before any deploy or teardown step runs. Mismatch
# fails the harness in ~9s instead of silently targeting the wrong
# account.
#
# Why this matters: clean-deploy.env doesn't pin AWS_PROFILE either,
# so an operator with the wrong default profile set in their shell
# can silently deploy CMS into the wrong account; preflight passes,
# deploy succeeds, resources land somewhere unexpected. This knob
# closes that gap when set; leaving it unset preserves the existing
# behavior (no account check).
#
# Set in your shell BEFORE invoking the harness, OR uncomment + fill
# below for a fixed-account workstation:
#   export EXPECTED_ACCOUNT_ID='123456789012'
#
# Backlog row: "Account pinning" (closed 2026-06-07).
export EXPECTED_ACCOUNT_ID="${EXPECTED_ACCOUNT_ID:-}"

# --- Required operator-supplied secrets ------------------------------
# CMS_DEMO_DEFAULT_PASSWORD — the staging Cognito demo-user password
# seeded by `deployment/stacks/ui_stack.py:~1239`. UIStack raises
# ValueError at synth/bootstrap walk if this is unset, which crashes
# `cdk bootstrap` with an opaque "Subprocess exited with error 1" and
# blocks every downstream phase of the harness.
#
# DO NOT default-fill this with a literal value — it is operator
# supplied per `~/.kiro/steering/secrets-handling.md`. The orchestrator's
# `preflight_env` phase fails loudly when it is missing.
#
# Set in your shell BEFORE invoking the harness:
#   export CMS_DEMO_DEFAULT_PASSWORD='<your-staging-password>'
# Or export and source this file with `set -a` semantics:
#   set -a; . deployment/config/clean-deploy.env; set +a
#
# Issue: issues/2026-06-03-clean-deploy-env-var-gate/
export CMS_DEMO_DEFAULT_PASSWORD="${CMS_DEMO_DEFAULT_PASSWORD:-}"

# --- v1 stack inventory toggles --------------------------------------
# Match spec.md § v1 in-scope stacks. The orchestrator (Group 3.1)
# reads these to decide which `make` targets to invoke.
export DEPLOY_FLEETWISE="${DEPLOY_FLEETWISE:-true}"
export DEPLOY_BEDROCK_AGENTS="${DEPLOY_BEDROCK_AGENTS:-true}"
export DEPLOY_TELEMETRY_INTEGRATION="${DEPLOY_TELEMETRY_INTEGRATION:-true}"

# --- v1.1 stack toggles (deferred) -----------------------------------
# Per decisions.md 2026-06-02 Decision C: VFO + predictive-agent stay
# deferred to v1.1. Connect is out of scope per PRD #5. Do NOT flip
# these without re-opening the spec.
export DEPLOY_VFO="${DEPLOY_VFO:-false}"
export DEPLOY_PREDICTIVE_AGENT="${DEPLOY_PREDICTIVE_AGENT:-false}"
export DEPLOY_CONNECT="${DEPLOY_CONNECT:-false}"

# --- Bedrock inference profile ---------------------------------------
# Populated at pre-flight time by `preflight_per_region.py --emit-env`.
# Leave blank here; the orchestrator captures the resolved value into
# this env var via `eval $(preflight_per_region.py --emit-env ...)`
# and passes it through to the CDK synth + IAM resolution in
# bedrock_agents_stack.py (Group 3.3).
#
# Expected resolved values per region geography (informative — not a
# hardcoded fallback):
#   ap-northeast-1 → jp.anthropic.claude-sonnet-4-6
#   eu-*           → eu.anthropic.claude-sonnet-4-6
#   us-*           → us.anthropic.claude-sonnet-4-6
#   <other>        → global.anthropic.claude-sonnet-4-6 (fallback)
export BEDROCK_INFERENCE_PROFILE_ID="${BEDROCK_INFERENCE_PROFILE_ID:-}"

# --- Run logging -----------------------------------------------------
# Per-run artefact root (logs, JSON reports, audit output). The
# orchestrator creates `${RUN_LOG_ROOT}/<run-id>/` per invocation.
export RUN_LOG_ROOT="${RUN_LOG_ROOT:-${HOME}/.cms/clean-deploy}"

# --- Telemetry assertion tuning --------------------------------------
# Group 4.2's `test_trip_materializes` polls DDB up to this timeout
# (seconds) waiting for the simulated trip row to land.
export TRIP_ASSERTION_TIMEOUT_SECS="${TRIP_ASSERTION_TIMEOUT_SECS:-600}"
