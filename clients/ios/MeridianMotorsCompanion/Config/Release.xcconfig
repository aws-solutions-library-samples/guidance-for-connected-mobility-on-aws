// Release.xcconfig — production endpoints (us-east-1)
//
// Used by the Release build configuration. Values mirror what was
// previously hardcoded into VSAConfig.swift; VSAConfig.swift now
// reads them via Info.plist with these as fallbacks if unset.
//
// Variable convention: every key is prefixed `VSA_` so a single
// Info.plist `$(VSA_*)` substitution maps cleanly. Server-side
// secrets (KMS ARNs, IAM role ARNs) MUST NEVER appear here — these
// values are baked into the iOS app binary.
//
// xcconfig syntax gotcha: `//` starts a line comment. URLs that
// contain `//` (every https/wss URL) MUST escape using `$()`. The
// substring `$()` evaluates to empty at build time, so
// `https:/$()/host/path` resolves to `https://host/path`. Without
// this, Xcode silently truncates the value at the first `//`.
//
// Authored by spec 2026-05-28-staging-auto-deploy.
//
// DEPLOYER NOTE: Replace every YOUR_* and 000000000000 placeholder
// below with your actual production deployment values before
// distributing a Release build. See your deployment runbook for how
// to obtain each value from CDK stack outputs.

VSA_AWS_REGION = us-east-1
VSA_REST_API_URL = https:/$()/YOUR_REST_API_ID.execute-api.us-east-1.amazonaws.com/prod
// CMS UI main API for the driver self-vehicle-claim flow. Empty in prod until
// the VSA pool is added to the prod CMS authorizer (CMS_EXTRA_USER_POOL_IDS) and
// the prod CMS UI API URL is filled in. When empty, VSAConfig.cmsRestApiUrl is
// nil and the iOS claim affordance is hidden (the no-vehicle message still shows).
VSA_CMS_REST_API_URL =
VSA_CONNECT_REGION = us-east-1
VSA_WS_API_URL = wss:/$()/YOUR_WS_API_ID.execute-api.us-east-1.amazonaws.com/prod
VSA_TELEMETRY_WS_URL = wss:/$()/YOUR_TELEMETRY_WS_ID.execute-api.us-east-1.amazonaws.com/live
VSA_AGENTCORE_RUNTIME_ARN = arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/YOUR_AGENTCORE_RUNTIME_ID
// Cognito: iOS authenticates against the CONSOLIDATED CMS UI pool
// (cms-prod-ui, us-east-1) — one pool per deployment serves both Fleet UI
// and iOS users. Client auth flows match (USER_PASSWORD_AUTH +
// USER_SRP_AUTH, no secret).
// NOTE: VSA_IDENTITY_POOL_ID below is unchanged — AgentCore/voice SigV4
// re-federation with the CMS pool is deferred to the CVX consolidation.
VSA_USER_POOL_ID = <REPLACE_WITH_USER_POOL_ID>
VSA_USER_POOL_CLIENT_ID = YOUR_COGNITO_APP_CLIENT_ID
VSA_IDENTITY_POOL_ID = us-east-1:00000000-0000-0000-0000-000000000000

// Demo password (DEBUG-only quick-pick prefill). Release builds ignore this
// key entirely — kept here as an empty declaration so the Info.plist
// substitution has something to resolve.
VSA_DEMO_PASSWORD =

// ─── Local overrides ─────────────────────────────────────────────────────────
// Optional include: `Release.local.xcconfig` (gitignored) holds real production
// values that must not ship publicly. If the file is absent, this include is a
// no-op (`#include?` is the optional variant) — the placeholder values above
// remain and `VSAConfig.swift`'s `plistString(_:)` guard triggers the Swift
// fallback + `assertionFailure` in Debug builds. See `Config/README.md` or
// `Release.local.xcconfig.example` for the schema.
//
// This pattern is intentional and permanent: real Cognito pool IDs, API
// endpoints, and runtime ARNs are per-deployment and must never be tracked in
// git. Refer to spec 2026-07-17-ios-tenant-canary-migration for the placeholder
// scrub, and issue 2026-07-20-ios-xcconfig-placeholders-not-injected for the
// local-override wire-up.
#include? "Release.local.xcconfig"

// APNs environment — production for Release/distribution builds
APS_ENVIRONMENT = production
