package com.aws.cms;

import org.apache.flink.streaming.api.datastream.DataStream;
import org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;

/**
 * Campaign Sync Processor with Direct IoT Core Publishing
 * No Lambda, No intermediate Kafka topic needed!
 */
public class CampaignSyncWithIoTSink {
    
    public static void main(String[] args) throws Exception {
        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();
        env.enableCheckpointing(60000);
        
        // Read heartbeats from Kafka
        DataStream<VehicleHeartbeat> heartbeats = env
            .addSource(KafkaSourceBuilder.buildHeartbeatSource())
            .name("vehicle-heartbeats-source");
        
        // Process and generate sync responses
        DataStream<CampaignSyncResponse> syncResponses = heartbeats
            .keyBy(VehicleHeartbeat::getVehicleId)
            .process(new CampaignSyncFunction())
            .name("campaign-sync-processor");
        
        // Write directly to IoT Core (no Lambda!)
        syncResponses
            .addSink(new IoTCoreSink())
            .name("iot-core-sink");
        
        env.execute("Campaign Sync with IoT Core Sink");
    }
}
