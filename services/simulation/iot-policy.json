{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iot:Connect"
      ],
      "Resource": "arn:aws:iot:us-east-1:022035076260:client/cms-telemetry-simulator-*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Publish"
      ],
      "Resource": [
        "arn:aws:iot:us-east-1:022035076260:topic/cms/telemetry/*",
        "arn:aws:iot:us-east-1:022035076260:topic/telemetry/*",
        "arn:aws:iot:us-east-1:022035076260:topic/vehicle/*"
      ]
    }
  ]
}
