CM_ BU_ ECM "Engine Control Module - powertrain signals";
CM_ BU_ TCM "Transmission Control Module";
CM_ BU_ BCM "Body Control Module - body electronics";
CM_ BU_ TPMS "Tire Pressure Monitoring System";
CM_ BU_ ADAS "Advanced Driver Assistance Systems";
CM_ BU_ BMS "Battery Management System";
CM_ BU_ ICM "Instrument Cluster Module";
CM_ BU_ HVAC "Climate Control Module";
CM_ BU_ LIGHT "Lighting Control Module";
CM_ BU_ CONN "Connectivity Module - WiFi/BT";
CM_ BU_ MAINT "Maintenance Monitoring Module";
CM_ BU_ GPS "GPS/Navigation Module";

CM_ BO_ 256 "Primary engine data - speed, RPM, temp, ignition (100ms cycle)";
CM_ BO_ 257 "Secondary engine data - oil, load, throttle, coolant (500ms cycle)";
CM_ BO_ 258 "Vehicle dynamics - accel, decel, odometer, fuel rate (100ms cycle)";
CM_ BO_ 272 "Transmission status and driver controls (200ms cycle)";
CM_ BO_ 288 "Body electronics - seatbelt, locks, windows, connectivity (500ms cycle)";
CM_ BO_ 304 "Tire pressure monitoring - all 4 wheels + temp (1000ms cycle)";
CM_ BO_ 305 "Tire tread depth monitoring - all 4 wheels (5000ms cycle)";
CM_ BO_ 320 "ADAS safety events - braking, acceleration, stability (100ms cycle)";
CM_ BO_ 321 "ADAS driver monitoring - phone, seatbelt, following (100ms cycle)";
CM_ BO_ 336 "12V battery and fuel system (1000ms cycle)";
CM_ BO_ 337 "EV/HV battery system - SOC, voltage, regen (1000ms cycle)";
CM_ BO_ 352 "Instrument cluster - heading, diagnostics (200ms cycle)";
CM_ BO_ 368 "HVAC climate control (2000ms cycle)";
CM_ BO_ 384 "Maintenance indicators - oil, brake, filter life (5000ms cycle)";
CM_ BO_ 400 "Exterior lighting systems (500ms cycle)";

