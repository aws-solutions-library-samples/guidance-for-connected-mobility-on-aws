  "metadata": {
    "description": "CS portal Meridian EV simulator transform manifest. Payload is gzip+base64-compressed JSON published via MQTT basic ingest to $aws/rules/{rule_name}/{vehicle_id}. vehicle_id is the topic suffix; it also appears as vehicleId in the decompressed payload body. timestamp is epoch_milliseconds. All signal_mappings are flat top-level keys — no nested paths.",
    "created_by": "spec/2026-09-12-cs-simulator-oem2-manifest-path T1.4",
    "created_at": "2026-09-12T00:00:00Z",
    "version": "1.0.0",
    "deferred_signals": [
      {
        "source_signal": "driverId",
        "reason": "no catalog match — payload field present but not in signal_catalog_seed.json"
      },
      {
        "source_signal": "lateralAcceleration",
        "reason": "no catalog match — use harsh_turn (same value, catalog-matched alias)"
      },
      {
        "source_signal": "eng_temp",
        "reason": "no catalog match — duplicate of engineTemp with progressive-degradation value; use engineTemp"
      },
      {
        "source_signal": "oil_press",
        "reason": "no catalog match — duplicate of oilPressure; use oilPressure"
      },
      {
        "source_signal": "tripProgress",
        "reason": "no catalog match — nested object, internal simulator bookkeeping only"
      },
      {
        "source_signal": "engineEvent",
        "reason": "no catalog match — lifecycle string (ENGINE_START/ENGINE_STOP), not a telemetry signal"
      },
      {
        "source_signal": "messageType",
        "reason": "no catalog match — always 'TELEMETRY', routing metadata not a signal"
      },
      {
        "source_signal": "is_ev",
        "reason": "no catalog match — boolean fleet-classification flag"
      },
      {
        "source_signal": "fuel_rate",
        "reason": "no catalog match — ICE-only fuel consumption, null for EVs"
      },
      {
        "source_signal": "fuel_lvl",
        "reason": "no catalog match — duplicate fuel level (ICE-only), null for EVs"
      },
      {
        "source_signal": "regen_pwr",
        "reason": "no catalog match — EV regenerative power kW"
      },
      {
        "source_signal": "soc (battery_voltage duplicate path)",
        "reason": "soc mapped above; volt mapped above; hv_voltage_base-derived fields (tractBattVoltage, battHVVoltage) not in catalog"
      }
    ]
  }
