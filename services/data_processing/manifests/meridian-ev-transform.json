    "required_fields": [],
    "range_checks": [
      {
        "field": "speed",
        "min": 0,
        "max": 200
      },
      {
        "field": "lat",
        "min": -90,
        "max": 90
      },
      {
        "field": "lng",
        "min": -180,
        "max": 180
      },
      {
        "field": "engineRPM",
        "min": 0,
        "max": 8000
      }
    ]
