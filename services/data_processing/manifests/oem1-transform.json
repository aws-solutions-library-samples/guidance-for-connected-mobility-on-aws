      "data_type": "float",
      "unit_conversion": "kpa_to_psi"
    },
    {
      "source_signal": "TIRE_PRESSURE_FR",
      "cms_field": "tire_fr",
      "source_path": "[?signal.wksSignal=TIRE_PRESSURE][?tags[?name.wktName=VEHICLE_WHEEL].value.wheelTagValue=FRONT_RIGHT].doubleValue",
      "data_type": "float",
      "unit_conversion": "kpa_to_psi"
    },
    {
      "source_signal": "TIRE_PRESSURE_RL",
      "cms_field": "tire_rl",
      "source_path": "[?signal.wksSignal=TIRE_PRESSURE][?tags[?name.wktName=VEHICLE_WHEEL].value.wheelTagValue=REAR_LEFT].doubleValue",
      "data_type": "float",
      "unit_conversion": "kpa_to_psi"
    },
    {
      "source_signal": "TIRE_PRESSURE_RR",
      "cms_field": "tire_rr",
      "source_path": "[?signal.wksSignal=TIRE_PRESSURE][?tags[?name.wktName=VEHICLE_WHEEL].value.wheelTagValue=REAR_RIGHT].doubleValue",
      "data_type": "float",
      "unit_conversion": "kpa_to_psi"
    },
    {
      "source_signal": "SEAT_BELT_STATUS",
      "cms_field": "seatbeltStatus",
      "source_path": "[?signal.wksSignal=SEAT_BELT_STATUS].enumValue.seatbeltStatus",
      "data_type": "boolean",
      "value_map": {
        "BUCKLED": true,
        "UNBUCKLED": false,
        "UNKNOWN_SEATBELT_STATUS": false
      }
    },
    {
      "source_signal": "GEAR_LEVER_POSITION",
      "cms_field": "gearPosition",
      "source_path": "[?signal.wksSignal=GEAR_LEVER_POSITION].enumValue.gearPosition",
      "data_type": "integer",
      "value_map": {
        "PARK": 0,
        "REVERSE": 1,
        "NEUTRAL": 2,
        "DRIVE": 3,
        "SPORT": 4,
        "LOW": 5,
        "UNKNOWN_GEAR_LEVER_POSITION": -1
      }
    },
    {
      "source_signal": "ACCELERATION_LONGITUDINAL",
      "cms_field": "acceleration",
      "source_path": "[?signal.wksSignal=ACCELERATION].threeAxisValue.x",
      "data_type": "float",
      "unit_conversion": "mps2_to_g"
    },
    {
      "source_signal": "ACCELERATION_LATERAL",
      "cms_field": "lateralG",
      "source_path": "[?signal.wksSignal=ACCELERATION].threeAxisValue.y",
      "data_type": "float",
      "unit_conversion": "mps2_to_g"
    },
    {
      "source_signal": "THROTTLE_POSITION",
      "cms_field": "throttle",
      "source_path": "[?signal.wksSignal=THROTTLE_POSITION].doubleValue",
      "data_type": "float"
    },
    {
      "source_signal": "OIL_LIFE_REMAINING",
      "cms_field": "oil_life",
      "source_path": "[?signal.wksSignal=OIL_LIFE_REMAINING].doubleValue",
      "data_type": "float"
    },
    {
      "source_signal": "TOTAL_ENGINE_TIME",
      "cms_field": "engine_hours_total",
      "source_path": "[?signal.wksSignal=TOTAL_ENGINE_TIME].doubleValue",
      "data_type": "float",
      "unit_conversion": "seconds_to_hours"
    },
    {
      "source_signal": "TRACTION_CONTROL_STATUS",
      "cms_field": "traction_control",
      "source_path": "[?signal.wksSignal=TRACTION_CONTROL_STATUS].enumValue.offOnStatus",
      "data_type": "boolean",
      "value_map": {
        "OFF_ON_STATUS_ON": true,
        "OFF_ON_STATUS_OFF": false,
        "ACTIVE": true,
        "INACTIVE": false
      }
    }
  ],
  "event_mappings": [
    {
      "_comment": "DELETED 5 entries (2026-06-08): diagnostic_warning, diagnostic_warning_cleared, dtc_set, dtc_cleared, cms.trip_report (TripReportEvent). All referenced oem1.ext.telemetry.event.* namespace which does NOT exist in _generated/ proto stubs and has NEVER fired in production. Real vehicle events arrive as autonomic.ext.event.Event. See decisions.md Phase A.1 / A.3 latent-bug audit.",
