{
  "manifest_version": "2.1.0",
  "transform_type": "cloud_to_cloud",
  "source_name": "oem1",
  "source_format": "json",
  "description": "OEM1 gRPC streaming feed transform manifest. Authored via OEMIntegrationWizard. Way B raw-shape paths: connector passes raw protobuf-as-JSON; Flink processor resolves per-signal extraction via manifest source_path (Option I Jackson-native walker). Compound signals disambiguated by tag predicate (TIRE_PRESSURE) or sub-field path (ACCELERATION).",
  "connection": {
    "type": "grpc_streaming"
  },
  "authentication": {
    "type": "oauth2",
    "credentials_secret_arn": "arn:aws:secretsmanager:us-west-2:123456789012:secret:cms-staging-connector-oem1-credentials"
  },
  "vehicle_id_extraction": {
    "strategy": "json_path",
    "path": "shard_key",
    "transform": "aui_asset_resolve"
  },
  "timestamp_field": "timestamp",
  "timestamp_format": "iso8601",
  "timestamp": {
    "modem_field": "modem_utc",
    "ingestion_field": "timestamp",
    "primary": "modem"
  },
  "message_type_routing": {
    "field": "typedData.@type",
    "telemetry_patterns": [
      "Metric",
      "ErrorMetric",
      "RawTelemetry",
      "BatchedTelemetry"
    ],
    "event_patterns": [
      "Event",
      "TriggeredEvent",
      "StateTransition",
      "GeofenceEvent",
      "DeepSleepPreclusion"
    ],
    "discard_patterns": [
      "BootstrapSummaryEvent",
      "BindingChangeEvent",
      "DataValidationEvent"
    ]
  },
  "unit_conversions": {
    "mps_to_mph": {
      "type": "multiply",
      "factor": 2.23694
    },
    "km_to_miles": {
      "type": "multiply",
      "factor": 0.621371
    },
    "C_to_F": {
      "type": "formula",
      "formula": "value * 1.8 + 32"
    },
    "kpa_to_psi": {
      "type": "multiply",
      "factor": 0.145038
    },
    "mps2_to_g": {
      "type": "divide",
      "factor": 9.80665
    },
    "seconds_to_hours": {
      "type": "divide",
      "factor": 3600
    }
  },
  "enum_maps": {
    "IGNITION_STATUS": {
      "ON": true,
      "OFF": false,
      "ACCESSORY": false,
      "UNKNOWN": false
    },
    "GEAR_LEVER_POSITION": {
      "PARK": 0,
      "REVERSE": 1,
      "NEUTRAL": 2,
      "DRIVE": 3,
      "SPORT": 4,
      "LOW": 5,
      "UNKNOWN_GEAR_LEVER_POSITION": -1
    },
    "SEAT_BELT_STATUS": {
      "BUCKLED": true,
      "UNBUCKLED": false,
      "UNKNOWN_SEATBELT_STATUS": false
    },
    "TRACTION_CONTROL_STATUS": {
      "ACTIVE": true,
      "INACTIVE": false,
      "OFF_ON_STATUS_OFF": false,
      "OFF_ON_STATUS_ON": true
    }
  },
  "signal_mappings": [
    {
      "source_signal": "SPEED",
      "cms_field": "speed",
      "source_path": "[?signal.wksSignal=SPEED].speedValue.speed",
      "data_type": "float",
      "unit_conversion": "mps_to_mph",
      "default_value": 0.0
    },
    {
      "source_signal": "ODOMETER",
      "cms_field": "odometer",
      "source_path": "[?signal.wksSignal=ODOMETER].doubleValue",
      "data_type": "float",
      "unit_conversion": "km_to_miles"
    },
    {
      "source_signal": "POSITION_LAT",
      "cms_field": "lat",
      "source_path": "[?signal.wksSignal=POSITION].positionValue.location[0].threeDPoint.latitude",
      "data_type": "float"
    },
    {
      "source_signal": "POSITION_LNG",
      "cms_field": "lng",
      "source_path": "[?signal.wksSignal=POSITION].positionValue.location[0].threeDPoint.longitude",
      "data_type": "float"
    },
    {
      "source_signal": "HEADING",
      "cms_field": "heading",
      "source_path": "[?signal.wksSignal=HEADING].headingValue.heading",
      "data_type": "float",
      "default_value": 0.0
