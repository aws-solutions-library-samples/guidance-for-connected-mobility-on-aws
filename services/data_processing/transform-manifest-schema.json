{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CMS Transform Manifest Schema",
  "version": "2.0.0",
  "description": "Schema for transformation manifests that normalize OEM telemetry to CMS Signal Catalog format. All cms_field values MUST match json_field in the signal catalog DynamoDB table.",

  "type": "object",
  "required": ["manifest_version", "transform_type", "source_name", "signal_mappings"],

  "properties": {
    "manifest_version": {
      "type": "string",
      "description": "Version of the transform manifest schema"
    },

    "transform_type": {
      "type": "string",
      "enum": ["cloud_to_cloud"],
      "description": "Type of transformation. cloud_to_cloud for OEM API integrations."
    },

    "source_name": {
      "type": "string",
      "description": "Name of the data source (no OEM brand names in code — use generic identifiers)"
    },

    "source_format": {
      "type": "string",
      "enum": ["json"],
      "description": "Format of source data. JSON only for cloud-to-cloud."
    },

    "connection": {
      "type": "object",
      "description": "How data arrives from the OEM",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["rest_polling", "grpc_streaming", "websocket_inbound"],
          "description": "rest_polling: poll their API in a loop. grpc_streaming: long-lived gRPC stream. websocket_inbound: accept inbound WebSocket connections."
        },
        "polling_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Polling interval (rest_polling only)"
        }
      }
    },

    "authentication": {
      "type": "object",
      "description": "Authentication configuration",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["oauth2", "api_key", "mtls"],
          "description": "oauth2 for most OEMs. api_key for simple integrations. mtls for inbound WebSocket."
        },
        "credentials_secret_arn": {
          "type": "string",
          "description": "ARN of Secrets Manager secret containing credentials"
        },
        "token_endpoint": {
          "type": "string",
          "description": "OAuth2 token endpoint URL (oauth2 only)"
        }
      }
    },

    "vehicle_id_extraction": {
      "type": "object",
      "description": "How to extract the vehicle ID from the source payload",
      "required": ["strategy", "path"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["json_path", "direct"],
          "description": "json_path: extract from nested path. direct: top-level field."
        },
        "path": {
          "type": "string",
          "description": "Dot-notation path to vehicle ID in source payload",
          "example": "vehicleId"
        },
        "transform": {
          "type": ["string", "null"],
          "enum": ["substring_after_last_slash", "substring_after_last_colon", null],
          "description": "Optional post-extraction transform"
        }
      }
    },

    "timestamp_field": {
      "type": "string",
      "description": "Field name in source payload containing the timestamp",
      "example": "timestamp"
    },

    "timestamp_format": {
      "type": "string",
      "enum": ["iso8601", "epoch_seconds", "epoch_milliseconds"],
      "description": "Format of the timestamp value"
    },

    "signal_mappings": {
      "type": "array",
      "description": "Array of signal transformation rules. cms_field values MUST match json_field in signal catalog.",
      "items": {
        "type": "object",
        "required": ["cms_field", "source_path"],
        "properties": {
          "source_signal": {
            "type": "string",
            "description": "OEM signal name (for documentation/debugging)"
          },
          "cms_field": {
            "type": "string",
            "description": "Target field name — MUST match json_field in signal catalog"
          },
          "source_path": {
            "type": "string",
            "description": "Dot-notation path to value in source JSON payload"
          },
          "data_type": {
            "type": "string",
            "enum": ["integer", "float", "string", "boolean"],
            "description": "Expected output data type"
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "Whether this signal must be present in every message"
          },
          "default_value": {
            "description": "Default value if source field is missing"
          },
          "unit_conversion": {
            "type": "string",
            "enum": [
              "mps_to_mph", "kph_to_mph", "km_to_miles",
              "C_to_F",
              "kpa_to_psi", "mbar_to_psi", "bar_to_psi",
              "mps2_to_g",
              "percent_100"
            ],
            "description": "Named unit conversion. Use for standard conversions."
          },
          "conversion": {
            "type": "object",
            "description": "Custom conversion (use when named unit_conversion doesn't cover it)",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["multiply", "divide", "add", "subtract", "formula"]
              },
              "factor": { "type": "number" },
              "offset": { "type": "number" },
              "formula": {
                "type": "string",
                "description": "Custom formula using 'value' as variable",
                "example": "value * 1.8 + 32"
              }
            }
          },
          "value_map": {
            "type": "object",
            "description": "Map source values to CMS values. Keys are source strings, values are CMS output.",
            "examples": [
              { "ON": true, "OFF": false },
              { "P": 0, "R": 1, "N": 2, "D": 3 }
            ]
          }
        }
      }
    },

    "validation": {
      "type": "object",
      "description": "Validation rules for transformed output",
      "properties": {
        "required_fields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "cms_field values that must be present in output"
        },
        "range_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          }
        }
      }
    },

    "metadata": {
      "type": "object",
      "properties": {
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
